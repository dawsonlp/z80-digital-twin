{
  "name": "Pasmo Z80 Assembly",
  "scopeName": "source.z80.pasmo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.z80",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.z80",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.z80",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.z80",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.z80",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.z80",
          "match": "(?i)(?<![A-Za-z0-9_?@.])(?:\\$[0-9a-f]+|0x[0-9a-f]+|#[0-9a-f]+|[0-9][0-9a-f]*h)(?![A-Za-z0-9_?@.$])"
        },
        {
          "name": "constant.numeric.binary.z80",
          "match": "(?i)(?<![A-Za-z0-9_?@.])(?:%[01]+|0b[01]+|[01]+b)(?![A-Za-z0-9_?@.$])"
        },
        {
          "name": "constant.numeric.decimal.z80",
          "match": "(?<![A-Za-z0-9_?@.])[0-9]+(?![A-Za-z0-9_?@.$])"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.z80",
          "match": "^\\s*([A-Za-z_?@.][A-Za-z0-9_?@.$]*)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.z80"
            }
          }
        }
      ]
    }
  }
}
