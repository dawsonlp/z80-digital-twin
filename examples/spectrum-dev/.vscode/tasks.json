{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Spectrum: Build",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/../../tools/spectrum_dev.py", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "pasmo",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(ERROR|WARNING): (.*) on line ([0-9]+) of file (.*)$",
          "severity": 1, "message": 2, "line": 3, "file": 4
        }
      }
    },
    {
      "label": "Spectrum: Build and Run",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/../../tools/spectrum_dev.py", "build-run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
